# The URL scheme picks the database (see prisma.config.ts):
#   SQLite for local development:
DATABASE_URL="file:./dev.db"
#   PostgreSQL (e.g. Aiven) for deployment — keep sslmode=require:
# DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require&connection_limit=5"

# Generate with: npx auth secret   (or any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account created by `npm run db:seed`. Use a strong password in production.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="Administrator"
